# Staging environment configuration
NODE_ENV=staging
POSTGRES_USER=hhvc
POSTGRES_PASSWORD=hhvc_staging_secure_pass
POSTGRES_DB=hhvc_staging
DATABASE_URL=postgresql://hhvc:hhvc_staging_secure_pass@postgres:5432/hhvc_staging
REDIS_URL=redis://redis:6379

API_PORT=3001
WEB_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

LOG_LEVEL=info
SCRAPER_HEADLESS=true
SCRAPER_CONCURRENCY=1
# HTTP(S)-прокси для скрапера. Пусто/не задано — прямой доступ (рекомендуется для прода).
# Напр. для dev за VPN: SCRAPER_PROXY=http://127.0.0.1:10809
SCRAPER_PROXY=

NEXT_PUBLIC_API_URL=/api
# Публичный префикс за обратным прокси (напр. /proxy/3000). Пусто — корень.
NEXT_PUBLIC_WEB_BASE_PATH=
WEB_BASE_PATH=
IMAGE_TAG=staging
