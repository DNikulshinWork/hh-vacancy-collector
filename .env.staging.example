# Staging environment configuration
NODE_ENV=staging
POSTGRES_USER=hhvc
POSTGRES_PASSWORD=hhvc_staging_secure_pass
POSTGRES_DB=hhvc_staging
DATABASE_URL=postgresql://hhvc:hhvc_staging_secure_pass@postgres:5432/hhvc_staging
REDIS_URL=redis://redis:6379

API_PORT=3001
WEB_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

LOG_LEVEL=info
SCRAPER_HEADLESS=true
SCRAPER_CONCURRENCY=1
# HTTP(S)-прокси для скрапера. Пусто/не задано — прямой доступ (рекомендуется для прода).
# Напр. для dev за VPN: SCRAPER_PROXY=http://127.0.0.1:10809
SCRAPER_PROXY=
# Базовый URL источника вакансий (по умолчанию https://hh.ru).
SCRAPER_BASE_URL=https://hh.ru

# --- Мониторинг (Sprint 5) ---
# Basic-auth для /metrics: nginx читает .htpasswd, файл генерируется локально:
#   METRICS_USER=... METRICS_PASSWORD=... ./scripts/gen-htpasswd.sh
METRICS_USER=
METRICS_PASSWORD=
# Alertmanager → Telegram (значения в git не коммитим).
# Оба значения обязательны для старта alertmanager: при пустых контейнер завершится
# с ошибкой (см. docs/monitoring.md §6). Для staging можно оставить пустыми, если
# алерты не нужны — тогда просто не поднимайте сервис alertmanager.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Grafana: доступна через nginx по /grafana/.
# Пароль ОБЯЗАТЕЛЕН (плейсхолдер ниже нужно заменить на реальный): compose не
# стартует без GRAFANA_ADMIN_PASSWORD, дефолта `admin` больше нет.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
GRAFANA_ROOT_URL=http://localhost/grafana/

NEXT_PUBLIC_API_URL=/api
# Публичный префикс Next basePath (только dev через code-server, напр.
# /absproxy/3000). В проде префикса нет — пусто.
WEB_BASE_PATH=
IMAGE_TAG=staging
