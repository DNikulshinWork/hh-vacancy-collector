# Production environment configuration
NODE_ENV=production
POSTGRES_USER=hhvc
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_production
POSTGRES_DB=hhvc
DATABASE_URL=postgresql://hhvc:change_this_to_a_strong_password_in_production@postgres:5432/hhvc
REDIS_URL=redis://redis:6379

API_PORT=3001
WEB_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

LOG_LEVEL=warn
SCRAPER_HEADLESS=true
SCRAPER_CONCURRENCY=2
# HTTP(S)-прокси для скрапера. Пусто/не задано — прямой доступ (рекомендуется для прода).
# Напр. для dev за VPN: SCRAPER_PROXY=http://127.0.0.1:10809
SCRAPER_PROXY=

NEXT_PUBLIC_API_URL=/api
# Публичный префикс за обратным прокси (напр. /proxy/3000). Пусто — корень.
NEXT_PUBLIC_WEB_BASE_PATH=
WEB_BASE_PATH=
IMAGE_TAG=latest
