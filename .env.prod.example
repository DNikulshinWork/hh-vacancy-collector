# Production environment configuration
NODE_ENV=production
POSTGRES_USER=hhvc
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_production
POSTGRES_DB=hhvc
DATABASE_URL=postgresql://hhvc:change_this_to_a_strong_password_in_production@postgres:5432/hhvc
REDIS_URL=redis://redis:6379

API_PORT=3001
WEB_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

LOG_LEVEL=warn
SCRAPER_HEADLESS=true
SCRAPER_CONCURRENCY=2
# HTTP(S)-прокси для скрапера. Пусто/не задано — прямой доступ (рекомендуется для прода).
# Напр. для dev за VPN: SCRAPER_PROXY=http://127.0.0.1:10809
SCRAPER_PROXY=
# Базовый URL источника вакансий (по умолчанию https://hh.ru).
SCRAPER_BASE_URL=https://hh.ru

# --- Мониторинг (Sprint 5) ---
# Basic-auth для /metrics: nginx читает .htpasswd, файл генерируется локально:
#   METRICS_USER=... METRICS_PASSWORD=... ./scripts/gen-htpasswd.sh
METRICS_USER=
METRICS_PASSWORD=
# Alertmanager → Telegram (обязательны в prod, значения в git не коммитим).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Grafana: доступна через nginx по /grafana/; пароль обязателен в prod.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_to_a_strong_password
GRAFANA_ROOT_URL=https://example.com/grafana/

NEXT_PUBLIC_API_URL=/api
# Публичный префикс Next basePath (только dev через code-server, напр.
# /absproxy/3000). В проде префикса нет — пусто.
WEB_BASE_PATH=
IMAGE_TAG=latest
