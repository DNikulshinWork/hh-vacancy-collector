NODE_ENV=
# Публичный префикс web-приложения (Next basePath). Только для dev через
# code-server: code.dnikulshin.ru/absproxy/3000 — префикс НЕ срезается.
# В проде префикса нет — оставить пустым.
# WEB_BASE_PATH=/absproxy/3000
WEB_BASE_PATH=
# URL API для браузера. Только для dev через code-server: /proxy/3001
# (префикс срезается прокси); в проде — /api.
# NEXT_PUBLIC_API_URL=/proxy/3001
NEXT_PUBLIC_API_URL=
LOG_LEVEL=
DATABASE_URL=
REDIS_URL=
API_PORT=
WEB_PORT=
SCRAPER_HEADLESS=
SCRAPER_CONCURRENCY=
# Базовый URL источника вакансий (по умолчанию https://hh.ru).
SCRAPER_BASE_URL=
# HTTP(S)-прокси для скрапера. Пусто/не задано — прямой доступ.
SCRAPER_PROXY=

# --- Мониторинг (Sprint 5) ---
# Basic-auth для /metrics через nginx; сам файл .htpasswd генерируется
# scripts/gen-htpasswd.sh и в git не хранится.
METRICS_USER=
METRICS_PASSWORD=
# Alertmanager → Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Grafana (доступна через nginx: /grafana/).
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
