NODE_ENV=
# Публичный префикс web-приложения (Next basePath). Только для dev через
# code-server: code.dnikulshin.ru/absproxy/3000 — префикс НЕ срезается.
# В проде префикса нет — оставить пустым.
# WEB_BASE_PATH=/absproxy/3000
WEB_BASE_PATH=
# URL API для браузера. Только для dev через code-server: /proxy/3001
# (префикс срезается прокси); в проде — /api.
# NEXT_PUBLIC_API_URL=/proxy/3001
NEXT_PUBLIC_API_URL=
LOG_LEVEL=
DATABASE_URL=
REDIS_URL=
API_PORT=
WEB_PORT=
SCRAPER_HEADLESS=
SCRAPER_CONCURRENCY=
# HTTP(S)-прокси для скрапера. Пусто/не задано — прямой доступ.
SCRAPER_PROXY=
