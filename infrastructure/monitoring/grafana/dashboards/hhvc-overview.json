{
  "uid": "hhvc-overview",
  "title": "hh-vacancy-collector — overview",
  "tags": ["hhvc", "sprint-5"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Таргеты UP",
      "datasource": { "type": "prometheus", "uid": "hhvc-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"api|worker\"}",
          "legendFormat": "{{ job }}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API — запросы в секунду",
      "datasource": { "type": "prometheus", "uid": "hhvc-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total[5m]))",
          "legendFormat": "{{ route }}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API — доля 5xx",
      "datasource": { "type": "prometheus", "uid": "hhvc-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0 },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API — латентность p95",
      "datasource": { "type": "prometheus", "uid": "hhvc-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "BullMQ — задачи в секунду",
      "datasource": { "type": "prometheus", "uid": "hhvc-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "min": 0 },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bullmq_jobs_completed_total[5m]))",
          "legendFormat": "completed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(bullmq_jobs_failed_total[5m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "BullMQ — активные задачи и вакансии в БД",
      "datasource": { "type": "prometheus", "uid": "hhvc-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bullmq_jobs_active_total)",
          "legendFormat": "active jobs"
        },
        {
          "refId": "B",
          "expr": "sum(hhvc_vacancies_total)",
          "legendFormat": "vacancies total"
        }
      ]
    }
  ]
}
